# ===== LLM（OpenAI 兼容端点，均可选；不配置则规则+检索模式）=====
USER_LLM_API_KEY=
USER_LLM_BASE_URL=https://api.deepseek.com/v1
USER_LLM_MODEL=deepseek-chat
# 失败冷却：普通故障 120s；429 配额打满只短冷却 5s（避免一次并发就整条链静默两分钟）
USER_LLM_COOLDOWN_SECONDS=120
USER_LLM_RATE_LIMIT_COOLDOWN_SECONDS=5

# 看图模型：留空则沿用主模型（多数 OpenAI 兼容端点的旗舰模型本身支持图片输入）
USER_VISION_MODEL=
# 生图模型（generate_image / 画图）
USER_IMAGE_MODEL=agnes-image-2.1-flash

# ===== 内置角色（可选）=====
# 默认人设是内置的猫娘「零」（core/persona.py）。想换成别的角色，
# 直接在这里写整段系统提示词；留空 = 用内置角色。
# 注意：多行文本请用控制台「秘书人设」页保存，这里只适合单行覆盖。
USER_PERSONA=

# ===== 输出质量（猫娘人设专用，可关）=====
# 严重问题（自称 AI / 报模型名 / 把已有能力说死 / 假转接）触发一次重写
QUALITY_REWRITE=1
# 多模型择优：候选数 >1 时闲聊类意图并行出多版，按规则挑硬伤少的
QUALITY_ENSEMBLE=1

# ===== 语音（send_voice 工具）=====
# edge-tts 音色；不装 edge-tts 时 send_voice 会明确回「语音合成没装」
TTS_VOICE=zh-CN-XiaoyiNeural

# ===== 表情包（第三方梗图学习 + 视觉打标）=====
# 群友梗图缓存目录；tags.json（视觉标签）与 index.json 都在这里
# 留空默认 <用户主目录>/napcat/emotes；Windows/Linux/macOS 都可以显式指定
GATEWAY_EMOTE_DIR=

# ===== 安全 =====
# 操作员/管理接口令牌；为空=开发模式（启动会告警），生产必须设置
ADMIN_TOKEN=
# 渠道共享密钥：设置后 /v1/ingest 与网关心跳需 X-Channel-Token 头（网关与核心保持一致）
# 核心服务暴露公网时必须设置，防伪造渠道消息与刷 LLM 成本
CHANNEL_TOKEN=
# 每身份限流：窗口秒数 / 窗口内最大消息数
RATE_LIMIT_WINDOW=60
RATE_LIMIT_MAX=20

# ===== 渠道会话 =====
# 渠道侧（QQ 群/私聊等）会话空闲多少秒后新建会话。
# 默认 12 小时：太短会让群友隔一会儿回来问「刚才那事」时机器人已失忆。
# TTL 到期换新会话时会自动带上上一段对话的尾巴，语境不会断。
SESSION_IDLE_TTL=43200
# 是否真有真人坐席可接管。默认 0（纯机器人）：对客说「转人工」时如实告知没有人工客服。
# 只有确实有人盯协作台时才置 1，否则会话会进入待接管而没人处理。
USER_HANDOFF_ENABLED=0

# ===== 提醒调度 =====
# 到期提醒扫描间隔（秒）与单条最大重试次数
REMINDER_TICK_SECONDS=30
REMINDER_MAX_ATTEMPTS=5

# ===== 域名解析覆盖（可选） =====
# 校园/内网 DNS 解析失败的自定义域，用 域=IP,域=IP 指定（如中转站走 Cloudflare）
LLM_HOSTS=

# ===== 存储 =====
CS_AGENT_DB=cs_agent.db
# 知识库与检索索引路径：留空用 core/data/ 默认值；Docker 部署必须指向持久卷（如 /data/kb.json），
# 否则容器重建会把知识库退回镜像内的种子数据
CS_AGENT_KB=
CS_AGENT_RETRIEVAL_DB=

# ===== 部署（可选） =====
# 单端口模式：core 直接托管前端构建产物（先 cd frontend && npm run build）
# 设置后 http://<host>:<port> 即是控制台入口，无需再跑 vite
CS_AGENT_STATIC_DIR=
# CORS 白名单（逗号分隔）；留空时默认只放行 http://localhost:5173（vite dev）
# 生产若同域反代可留空；前后端分域部署必须填控制台实际域名
CS_AGENT_CORS_ORIGINS=

# ===== NoneBot 网关（gateway/.env 或环境变量）=====
# NapCat 等 OneBot v11 协议端的反向 WS 地址（网关作为客户端去连）
ONEBOT_WS_URL=ws://127.0.0.1:3001
# NapCat 若在 WebUI 里开启了 access token，这里必须填同一个值，
# 否则网关握手会被协议端以 403 拒绝（实测过这个坑）
ONEBOT_ACCESS_TOKEN=
# 核心服务地址
CORE_BASE_URL=http://127.0.0.1:8010

# ===== 电脑执行器（可选）=====
# 不启动执行器时，电脑操作动作返回 503；对话/QQ 功能不受影响
EXECUTOR_URL=http://127.0.0.1:8020
# 非空时执行器校验 HMAC 签名，core 与执行器必须一致
EXECUTOR_TOKEN=
EXECUTOR_PORT=8020
# 只允许回环；改 0.0.0.0 必须同时设置 EXECUTOR_TOKEN
EXECUTOR_BIND=127.0.0.1
EXECUTOR_POLICY_PATH=./policy.json

# ===== 网关内部动作端点 =====
# core 通过这个地址调用网关 /internal/action；网关自身监听 PORT（默认 8011）
GATEWAY_ACTION_URL=http://127.0.0.1:8011
# 群聊防刷屏：同一群两条回复的最小间隔（秒）/ 每群每小时回复上限（超限静默丢弃）
GATEWAY_GROUP_MIN_GAP=10
GATEWAY_GROUP_HOURLY_CAP=120
# 乒乓循环护栏：对面也是机器人（道别复读/回声/问题连发/秒回连击）就静默，
# 防两个 bot 互道晚安刷一整夜。1=开（默认），0=关。
GATEWAY_LOOP_GUARD=1
# 静默时长（秒），默认 30 分钟；同一对象 2 小时内再犯翻倍，最长 4 小时
GATEWAY_LOOP_MUTE_S=1800
# 静默状态落盘路径（网关重启不丢）
GATEWAY_LOOP_STATE=logs/loop_guard.json

# ===== Agent 权限档位 =====
# 0 只读 / 1 辅助（默认）/ 2 受信 / 3 自主（需 ALLOW_TIER3=true 双开关）
AGENT_TIER=1
ALLOW_TIER3=false

# ===== 联网搜索（可选）=====
# 不配置则前端开关不可用；配置后对话可引用实时信息
# 四选一：bing（免 Key，国内直连，默认）/ tavily / serper / searxng
# bing 走 HTML 抓取 + 新闻 RSS 双通道：时效性问题也能拿到当天条目
SEARCH_PROVIDER=bing
TAVILY_API_KEY=
SERPER_API_KEY=
# 自建 SearXNG 实例地址（需开启 json 输出格式）
SEARXNG_URL=

# ===== 业务工具对接（可选）=====
# 不配置时订单/退款工具返回"未接入"，不会伪造数据
ORDER_QUERY_URL=
ORDER_QUERY_TOKEN=
REFUND_API_URL=
REFUND_API_TOKEN=

# ===== 动作层服务间鉴权 =====
# 网关/Agent 以服务身份调用动作接口时使用；不配置则只能靠 ADMIN_TOKEN
AGENT_TOKEN=

# ===== Agent 特权工具白名单 =====
# 只有这些 QQ 号能触达读写主机文件、以机器人身份主动发消息（逗号分隔）。
# 留空 = 所有 QQ 用户都只能用记忆/提醒/检索这类只作用于自己的工具。
# 主人账号（示例，替换成你自己的 QQ）：它的指令机器人必须执行，
# 也是唯一允许做真机测试的账号——不要把别人的 QQ 加进来。
# 留空即无人享有特权；填你自己的 QQ 号（用逗号分隔多个）
AUTHORIZED_QQ=

# ===== 向量语义检索（可选）=====
# 模型目录（本地路径）或 HF 模型 id；默认 BAAI/bge-small-zh-v1.5
USER_EMB_MODEL=
# 向量维度：留空自动读模型 config.json 的 hidden_size（bge-small-zh = 512）。
# 手填注意别和模型不一致，否则 vec 插入会 Dimension mismatch、向量检索静默失效。
USER_EMB_DIM=
# 模型不在本地缓存时是否允许联网下载。默认关闭：HF 默认重试会把首次检索
# 阻塞 80 秒以上，服务看起来像挂死；需要下载时临时置 1。
USER_EMB_ALLOW_DOWNLOAD=0

# ===== MCP 工具暴露（可选，python -m core.mcp_server）=====
# 默认只暴露只读工具；写工具（记忆/提醒）需显式开启
ZHIKE_MCP_ALLOW_WRITE=0


# ===== 运行日志落盘（可选）=====
# 默认写到 CS_AGENT_DB 同目录的 logs/app.log（8MB 轮转，保留 3 份）。
# 容器里已有 stdout 采集时可设 off 关闭。
CS_AGENT_LOG_FILE=

# ===== 语音输入（收 QQ 语音消息转文字，可选）=====
# faster-whisper 本地模型目录；不配则用内置默认路径，路径不存在时网关回「语音听不了」
# 模型下载约 460MB，见 DEPLOY.md
ASR_MODEL=
# 也可以完全不用本地模型，交给外部命令（{wav} 会被替换成临时 wav 路径，stdout 即文本）
ASR_CMD=
# CPU 线程数（默认 4）
ASR_THREADS=4
# ffmpeg 可执行文件路径（AMR → WAV 必需）
FFMPEG_BIN=ffmpeg
