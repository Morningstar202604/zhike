# ============================================================
# 知客 Zhike 生产部署配置（复制为 .env 后填写）
# 令牌生成：openssl rand -hex 16
# ============================================================

# ===== 必填 =====
# 机器人 QQ 号（建议小号；首次启动需进 NapCat WebUI 扫码登录）
NAPCAT_QQ=
# 管理台/坐席接口令牌：进控制台「管理中心」登录用
ADMIN_TOKEN=changeme-admin-token
# 渠道共享密钥：core 与 gateway 必须一致；防公网伪造消息
CHANNEL_TOKEN=changeme-channel-token

# ===== LLM（可选；不填=规则+检索模式，照样能用）=====
# 免费公益方案：智谱 GLM-4-Flash（bigmodel.cn 注册即送 Key，Flash 档 0 元）
USER_LLM_API_KEY=
USER_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
USER_LLM_MODEL=glm-4-flash
# 其他 OpenAI 兼容端点（DeepSeek 等）替换 BASE_URL/MODEL 即可

# ===== 管线参数（默认即可）=====
RATE_LIMIT_WINDOW=60
RATE_LIMIT_MAX=20
SESSION_IDLE_TTL=1800

# ===== 网络（可选）=====
# LLM 域名解析覆盖（域=IP,域=IP），校园/内网 DNS 解析失败时用
LLM_HOSTS=
# CORS 白名单（逗号分隔）；走反代同域时可留空，公网直连建议填控制台域名
CS_AGENT_CORS_ORIGINS=
# core 端口绑定：0.0.0.0=全网卡（公网直连）；127.0.0.1=仅本机（CF Tunnel/反代场景推荐）
ZHIKE_BIND=0.0.0.0

# ===== 持久化（compose 已内置，通常不用改）=====
# 容器内路径指向 /data 卷；改这里等于换存储位置，务必确认目录可写
CS_AGENT_DB=/data/cs_agent.db
CS_AGENT_KB=/data/kb.json
CS_AGENT_RETRIEVAL_DB=/data/retrieval.db

# ===== 动作层（可选）=====
# 权限档位：0 只读 / 1 辅助（默认）/ 2 受信 / 3 自主（需同时设 ALLOW_TIER3=true）
AGENT_TIER=1
ALLOW_TIER3=false
# 允许 Agent 在 T3 自主执行的动作（逗号分隔，留空=仅只读）
ALLOWED_ACTIONS_T3=
# 授权 QQ 号（逗号分隔）：这些用户的指令可触发写操作
AUTHORIZED_QQ=
# 破坏性动作（踢人/退群/删好友/提权）总开关，默认关闭
ACTION_L2_ENABLED=false
ACTION_MIN_INTERVAL_MS=2000
ACTION_MAX_PER_HOUR=30
# core 调用网关动作端点的地址（compose 内网）
GATEWAY_ACTION_URL=http://gateway:8011
# NapCat access token（WebUI 开启后必须一致）
ONEBOT_ACCESS_TOKEN=
